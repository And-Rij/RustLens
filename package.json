{
  "name": "rust-lens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "models:download": "node scripts/download-ocr.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,ts}\" \"*.json\" \"*.ts\" index.html README.md .github/workflows/checks.yml",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.{mjs,ts}\" \"*.json\" \"*.ts\" index.html README.md .github/workflows/checks.yml",
    "test:frontend": "node --test scripts/test-selection-geometry.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "12.11.2"
  }
}
